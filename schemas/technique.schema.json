{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://firai.cybersciencelab.com/schemas/technique.schema.json",
  "title": "FIRAI Technique",
  "type": "object",
  "required": ["id", "name", "phase", "evidence_classes", "access_capability", "maturity", "lifecycle_stages", "status"],
  "additionalProperties": true,
  "$defs": {
    "lifecycleStage": {
      "type": "string",
      "enum": [
        "Plan and Design",
        "Collect and Process Data",
        "Build and Use Model",
        "Verify and Validate",
        "Deploy and Use",
        "Operate and Monitor",
        "Use or Impacted by"
      ],
      "description": "AI lifecycle stages exactly as named in the Lifecycle Stage row of NIST AI 100-1 (AI RMF 1.0), Figure 3, in lifecycle order."
    },
    "absenceState": {
      "type": "string",
      "enum": [
        "confirmed_nonexistent",
        "not_configured",
        "expired",
        "not_retained",
        "inaccessible",
        "not_produced",
        "not_searched",
        "unknown"
      ],
      "description": "P1-26: 'provider did not produce' (not_produced) is a distinct state from 'logs do not exist' (confirmed_nonexistent) — the distinction matters to both inference and later legal assessment."
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$",
      "description": "Technique ID. Sub-techniques use a dotted suffix, e.g. T0104.001."
    },
    "name": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": ["P01", "P02", "P03", "P04", "P05"]
    },
    "sub_of": {
      "type": ["string", "null"],
      "pattern": "^T[0-9]{4}$"
    },
    "evidence_classes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "access_capability": {
      "type": "array",
      "items": { "type": "string", "enum": ["W", "G", "B"] },
      "description": "Coverage/reachability only \u2014 not a claim-strength scale (Principle 5)."
    },
    "evidence_role": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["source", "reference", "investigator_generated", "derived_work_product", "corroborative_external"]
      }
    },
    "maturity": {
      "type": "object",
      "required": ["base"],
      "properties": {
        "base": { "type": "string", "enum": ["Established", "Demonstrated", "Proposed"] },
        "qualification": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "lifecycle_stages": {
      "type": "array",
      "minItems": 1,
      "description": "FIRAI's mapping of the technique onto the AI lifecycle stages of NIST AI 100-1 (AI RMF 1.0), Figure 3. A stage is listed where the technique's evidence prerequisites can exist and the technique can meaningfully operate. This is structural applicability, not the probability that evidence will be available in a given case. Stages not listed are not mapped. See lifecycle-mapping.md.",
      "items": {
        "type": "object",
        "required": ["stage", "applicability"],
        "additionalProperties": false,
        "properties": {
          "stage": { "$ref": "#/$defs/lifecycleStage" },
          "applicability": {
            "type": "string",
            "enum": ["applicable", "rarely"],
            "description": "applicable: the required evidence can ordinarily be generated, retained or accessed in this stage under a plausible implementation. rarely: the evidence may be available but needs atypical retention, access or architectural conditions."
          }
        }
      }
    },
    "readiness_measures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relationship"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]{4}$" },
          "relationship": { "type": "string", "enum": ["required", "enabling", "strengthening"] }
        }
      }
    },
    "description": { "type": ["string", "null"] },
    "originality_rationale": {
      "type": "string",
      "minLength": 1,
      "description": "For a Proposed technique with no references: why no prior method is cited, pointing to the dated search in novelty-and-gap-method.md. The Proposed grade is not a reference bypass. Techniques graded above Proposed must cite references instead."
    },
    "notes": { "type": ["string", "null"] },
    "absence_state_vocabulary": {
      "type": "array",
      "items": { "$ref": "#/$defs/absenceState" },
      "description": "The absence-state enum this technique defines/uses (T0104 is the normative source, per P1-26)."
    },
    "classical_ancestry": { "type": ["string", "null"] },
    "claim_profile": {
      "type": "object",
      "properties": {
        "does_establish": { "type": "array", "items": { "type": "string" } },
        "does_not_establish": { "type": "array", "items": { "type": "string" } },
        "alternative_propositions": { "type": "array", "items": { "type": "string" } },
        "corroboration_requirements": { "type": "array", "items": { "type": "string" } },
        "quality_controls": { "type": "array", "items": { "type": "string" } },
        "stop_conditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "status"],
        "properties": {
          "text": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "verify"] }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "superseded", "withdrawn"]
    },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": ["string", "null"] },
    "replaced_by": { "type": ["string", "null"] }
  }
}
